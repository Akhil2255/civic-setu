{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated citizen or administrator profile stored in Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["citizen", "company_admin", "state_admin", "district_admin", "municipality_admin", "department_admin", "field_officer"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "role", "createdAt", "updatedAt"]
    },
    "CivicIssue": {
      "title": "CivicIssue",
      "description": "Public infrastructure complaint record synced for citizen & civic tracking",
      "type": "object",
      "properties": {
        "complaintCode": { "type": "string", "minLength": 5, "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reporterUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "description": { "type": "string", "minLength": 5, "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 80 },
        "severity": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
        "status": { "type": "string", "enum": ["Submitted", "Under Review", "Assigned to Department", "Accepted by Department", "Field Inspection", "Work in Progress", "Resolved", "Citizen Verification", "Closed", "Reopened"] },
        "municipalityName": { "type": "string", "maxLength": 100 },
        "districtName": { "type": "string", "maxLength": 100 },
        "stateName": { "type": "string", "maxLength": 100 },
        "departmentName": { "type": "string", "maxLength": 120 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["complaintCode", "reporterUid", "title", "description", "category", "severity", "status", "municipalityName", "districtName", "stateName", "departmentName", "latitude", "longitude", "createdAt", "updatedAt"]
    },
    "RoadPassportRecord": {
      "title": "RoadPassportRecord",
      "description": "Digital lifecycle passport for road excavation and infrastructure restoration",
      "type": "object",
      "properties": {
        "passportCode": { "type": "string", "minLength": 4, "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assetName": { "type": "string", "minLength": 3, "maxLength": 160 },
        "departmentName": { "type": "string", "maxLength": 120 },
        "purpose": { "type": "string", "maxLength": 300 },
        "workStatus": { "type": "string", "enum": ["Planned", "Excavation Active", "Restoration Pending", "Completed", "Overdue", "Flagged"] },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["passportCode", "assetName", "departmentName", "purpose", "workStatus", "createdByUid", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile documents restricted to owner or verified platform admin"
    },
    "/issues/{issueId}": {
      "schema": { "$ref": "#/entities/CivicIssue" },
      "description": "Citizen infrastructure complaints with owner-scoped read/write and admin oversight"
    },
    "/road_passports/{passportId}": {
      "schema": { "$ref": "#/entities/RoadPassportRecord" },
      "description": "Road Passport digital infrastructure logs managed by verified officials"
    }
  }
}
